{
  "kind": "collectionType",
  "collectionName": "enrollments",
  "info": {
    "singularName": "enrollment",
    "pluralName": "enrollments",
    "displayName": "Enrollment"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true,
      "inversedBy": "enrollments"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "required": true,
      "inversedBy": "enrollments"
    },
    "completedLessons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::lesson.lesson",
      "inversedBy": "enrollments"
    },
    "progress": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 100
    },
    "isCompleted": {
      "type": "boolean",
      "default": false
    }
  }
}
