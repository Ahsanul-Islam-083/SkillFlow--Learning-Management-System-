{
  "kind": "collectionType",
  "collectionName": "quiz_submissions",
  "info": {
    "singularName": "quiz-submission",
    "pluralName": "quiz-submissions",
    "displayName": "QuizSubmission"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "score": {
      "type": "integer",
      "required": true,
      "min": 0,
      "max": 100
    },
    "isPassed": {
      "type": "boolean",
      "default": false
    },
    "userAnswers": {
      "type": "json",
      "required": true
    },
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true,
      "inversedBy": "quiz_submissions"
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "required": true,
      "inversedBy": "quiz_submissions"
    }
  }
}
